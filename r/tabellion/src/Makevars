OBJECTS = entrypoint.o
RUSTLIB = rustlib/target/release/libtabellion.a
PKG_LIBS = $(RUSTLIB) -lgcc_s -lutil -lrt -lpthread -lm -ldl

all: $(SHLIB)

$(SHLIB): $(RUSTLIB)

.PHONY: cargo-force
$(RUSTLIB): cargo-force
	R_HOME="$(R_HOME)" cargo build --release --manifest-path rustlib/Cargo.toml --target-dir rustlib/target
